
<%- include('partials/header') %>

<main class="container main-content">

    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">MAKE A DIFFERENCE</p>

            <h1><%= title %></h1>

            <h2>Welcome to the CSE 340 Service Network!</h2>

            <p>
                Our mission is to promote service across the world
                by connecting volunteers with service opportunities
                in their community.
            </p>

            <a href="/projects" class="button">
                Explore Service Projects
            </a>
        </div>

        <div class="hero-image">
            <img
                class="main-logo"
                src="/images/cse340-service-network.png"
                alt="CSE 340 Service Network Logo"
            >
        </div>
    </section>

    <section class="intro-section">
        <h2>Make an Impact in Your Community</h2>

        <p>
            Discover organizations, explore meaningful projects,
            and find opportunities to help others.
        </p>

        <div class="feature-grid">

            <article class="feature-card">
                <h3>Organizations</h3>
                <p>Discover organizations making a difference.</p>
                <a href="/organizations">Explore Organizations</a>
            </article>

            <article class="feature-card">
                <h3>Projects</h3>
                <p>Find opportunities to volunteer and contribute.</p>
                <a href="/projects">View Projects</a>
            </article>

            <article class="feature-card">
                <h3>Categories</h3>
                <p>Explore different areas of community service.</p>
                <a href="/categories">Browse Categories</a>
            </article>

        </div>
    </section>

</main>

<%- include('partials/footer') %>
