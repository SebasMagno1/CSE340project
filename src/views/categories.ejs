
<%- include('partials/header') %>

<main class="container main-content">

    <section class="page-intro">
        <p class="eyebrow">EXPLORE OPPORTUNITIES</p>

        <h1><%= title %></h1>

        <p>
            Explore our service project categories
            and discover different ways to make a difference.
        </p>
    </section>

    <section class="category-grid">

        <% if (categories && categories.length > 0) { %>

            <% categories.forEach((category) => { %>

                <article class="category-card">

                    <div class="category-icon" aria-hidden="true">
                        &#128204;
                    </div>

                    <h2>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </h2>

                    <a
                        class="text-link"
                        href="/category/<%= category.category_id %>"
                        aria-label="Explore <%= category.category_name %> projects"
                    >
                        Explore projects →
                    </a>

                </article>

            <% }) %>

        <% } else { %>

            <p>No service project categories were found.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>
