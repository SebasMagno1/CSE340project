<%- include('../partials/header') %>

<main class="container main-content">
    <%- include('../partials/messages') %>
    <p><a class="text-link" href="/edit-category/<%= category.category_id %>">Edit category</a></p>

    <section class="page-intro">

        <p class="eyebrow">SERVICE CATEGORY</p>

        <h1><%= category.category_name %></h1>

        <p>
            Explore service opportunities available
            in this category.
        </p>

        <a href="/categories" class="text-link">
            ← Back to Categories
        </a>

    </section>

    <section class="project-grid">

        <% if (projects && projects.length > 0) { %>

            <% projects.forEach((project) => { %>

                <article class="project-card">

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.project_name %>
                        </a>
                    </h2>

                    <p><%= project.project_description %></p>

                    <p>
                        <strong>Organization:</strong>

                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <a
                        href="/project/<%= project.project_id %>"
                        class="text-link"
                    >
                        View project →
                    </a>

                </article>

            <% }) %>

        <% } else { %>

            <p>There are currently no projects in this category.</p>

        <% } %>

    </section>

</main>

<%- include('../partials/footer') %>