<%- include('partials/header') %>

<main class="container main-content">

    <section class="page-intro">
        <p><a class="button" href="/new-organization">Add organization</a></p>
        <p class="eyebrow">OUR COMMUNITY</p>

        <h1><%= title %></h1>

        <p>
            Meet the organizations creating meaningful
            service opportunities.
        </p>
    </section>

    <section class="organization-grid">

        <% if (organizations && organizations.length > 0) { %>

            <% organizations.forEach((organization) => { %>

                <article class="organization-card">

                    <% if (organization.organization_logo) { %>

                        <img
                            src="<%= organization.organization_logo %>"
                            alt="<%= organization.organization_name %> logo"
                            loading="lazy"
                        >

                    <% } %>

                    <h2>
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.organization_name %>
                        </a>
                    </h2>

                    <p>
                        <%= organization.organization_description %>
                    </p>

                    <% if (organization.organization_email) { %>

                        <a href="mailto:<%= organization.organization_email %>">
                            <%= organization.organization_email %>
                        </a>

                    <% } %>

                    <p>
                        <a class="text-link"
                           href="/organization/<%= organization.organization_id %>">
                            View organization →
                        </a>
                    </p>

                </article>

            <% }) %>

        <% } else { %>

            <p>No partner organizations were found.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>