
<%- include('partials/header') %>

<main class="container main-content">

    <section class="page-intro">
        <p class="eyebrow">OUR COMMUNITY</p>
        <h1><%= title %></h1>

        <p>
            Here are a few of our partner organizations:
        </p>
    </section>

    <section class="organization-grid">

        <article class="organization-card">
            <img
                src="/images/brightfuture-logo.png"
                alt="BrightFuture Builders logo"
            >

            <h2>BrightFuture Builders</h2>

            <p>
                Helping communities build brighter futures.
            </p>

            <a href="mailto:info@brightfuture.org">
                info@brightfuture.org
            </a>
        </article>

        <article class="organization-card">
            <img
                src="/images/greenharvest-logo.png"
                alt="GreenHarvest Growers logo"
            >

            <h2>GreenHarvest Growers</h2>

            <p>
                Supporting sustainable communities and agriculture.
            </p>

            <a href="mailto:contact@greenharvest.org">
                contact@greenharvest.org
            </a>
        </article>

        <article class="organization-card">
            <img
                src="/images/unityserve-logo.png"
                alt="UnityServe Volunteers logo"
            >

            <h2>UnityServe Volunteers</h2>

            <p>
                Connecting volunteers with meaningful service.
            </p>

            <a href="mailto:hello@unityserve.org">
                hello@unityserve.org
            </a>
        </article>

    </section>

</main>

<%- include('partials/footer') %>
