
<%- include('partials/header') %>

<main class="container main-content">

    <section class="page-intro">
        <p class="eyebrow">GET INVOLVED</p>

        <h1><%= title %></h1>

        <p>
            Discover opportunities to serve and make
            a positive difference in your community.
        </p>
    </section>

    <section class="project-grid">

        <article class="project-card">
            <span class="project-number">01</span>

            <h2>Park Cleanup</h2>

            <p>
                Join us to clean up local parks and make
                them beautiful!
            </p>

            <span class="project-category">Environmental</span>
        </article>

        <article class="project-card">
            <span class="project-number">02</span>

            <h2>Food Drive</h2>

            <p>
                Help collect and distribute food
                to those in need.
            </p>

            <span class="project-category">Community Service</span>
        </article>

        <article class="project-card">
            <span class="project-number">03</span>

            <h2>Community Tutoring</h2>

            <p>
                Volunteer to tutor students in various subjects.
            </p>

            <span class="project-category">Educational</span>
        </article>

    </section>

</main>

<%- include('partials/footer') %>
