<%- include('partials/header') %>

<main class="container main-content">

    <section class="page-intro">
        <p><a class="button" href="/new-project">Add service project</a></p>
        <p class="eyebrow">GET INVOLVED</p>

        <h1><%= title %></h1>

        <p>
            Discover opportunities to serve and make
            a positive difference in your community.
        </p>
    </section>

    <section class="project-grid">

        <% if (projects && projects.length > 0) { %>

            <% projects.forEach((project) => { %>

                <article class="project-card">

                    <span class="project-number">
                        <%= String(project.project_id).padStart(2, '0') %>
                    </span>

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.project_name %>
                        </a>
                    </h2>

                    <p><%= project.project_description %></p>

                    <p>
                        <strong>Organization:</strong>

                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p>
                        <strong>Date:</strong>

                        <%= project.date
                            ? new Date(project.date).toLocaleDateString()
                            : 'To be announced' %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location || 'To be announced' %>
                    </p>

                    <a class="text-link"
                       href="/project/<%= project.project_id %>">
                        View project details →
                    </a>

                </article>

            <% }) %>

        <% } else { %>

            <p>No upcoming service projects were found.</p>

        <% } %>

    </section>

</main>

<%- include('partials/footer') %>